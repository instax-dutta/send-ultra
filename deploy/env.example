# Copy to .env next to package.json and edit. Every value here is read at startup,
# so a change needs a restart to take effect.

NODE_ENV=production

# The port Send listens on. Keep it private and put a reverse proxy or a
# Cloudflare tunnel in front of it; nothing here is meant to face the internet.
PORT=18100
IP_ADDRESS=127.0.0.1

# The address people actually visit. This goes into every link Send generates,
# so a wrong value produces links that point nowhere.
BASE_URL=https://send.example.com

# Largest upload accepted, in bytes. 10737418240 is 10 GiB.
#
# Uploads stream to disk rather than buffering in memory, so this is a disk
# allowance and not a memory one. It is still the number an abusive client will
# aim at, which is why a rate limit belongs in front of the service.
MAX_FILE_SIZE=10737418240

# Where ciphertext is written. Must be writable by the service user and should
# not be inside the checkout, so a redeploy cannot touch it. The systemd unit
# grants write access to this path and nothing else.
FILE_DIR=/opt/send-ultra-data/files

# The dedicated Redis from deploy/redis/send-ultra.conf. Never point this at a
# shared instance: flushing it would delete every link.
REDIS_HOST=127.0.0.1
REDIS_PORT=18101
REDIS_DB=0

# Optional. Leave empty to disable error reporting.
SENTRY_DSN=
